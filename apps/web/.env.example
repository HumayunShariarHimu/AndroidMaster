# Use wss:// for a deployed relay; ws:// is for local development.
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080
# Required for the owner login; generate a long random value for production.
ADMIN_PASSWORD=replace-with-a-strong-owner-password
AUTH_SECRET=replace-with-a-long-random-secret
# Required for the persistent device registry. Vercel adds this when the private Blob store is connected.
BLOB_READ_WRITE_TOKEN=configure-from-your-private-vercel-blob-store
